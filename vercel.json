{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "frontend",
        "url": "/index.html"
      }
    },
    {
      "source": "/predict",
      "destination": {
        "service": "frontend",
        "url": "/index.html"
      }
    },
    {
      "source": "/performance",
      "destination": {
        "service": "frontend",
        "url": "/index.html"
      }
    },
    {
      "source": "/analytics",
      "destination": {
        "service": "frontend",
        "url": "/index.html"
      }
    },
    {
      "source": "/dataset",
      "destination": {
        "service": "frontend",
        "url": "/index.html"
      }
    },
    {
      "source": "/about",
      "destination": {
        "service": "frontend",
        "url": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}